# Discord (Developer Portal -> Bot -> Token; General Information -> Application ID)
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id
# Optional: lets the admin AI list/search members by name. Enable "Server Members Intent"
# in the Developer Portal first, otherwise the bot will refuse to log in.
ENABLE_GUILD_MEMBERS_INTENT=false

# Supabase (Project Settings -> API). Tickets are stored in the "tickets" table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Ticket assistant: the client version(s) the server supports, newest last. A ticket that
# names any other version gets an upgrade hint with a 👍 / 👎. Comma separated for several builds.
SUPPORTED_CLIENT_VERSION=1.21.11

# Verification
# Role granted by /verify. Defaults to "champ"; matching ignores capitals and also accepts
# "verified". When no matching role exists, the bot creates this role (needs Manage Roles).
VERIFIED_ROLE_NAME=Champ
# Optional role removed when someone verifies, so nobody keeps an "unverified" role.
UNVERIFIED_ROLE_NAME=unverified

# Owner-only commands: /key, /manage and the setup commands. Comma separated role names.
# The Discord server owner always has access, even without this role.
OWNER_ROLE_NAME=owner

# Customer website: /key tells the owner where customers redeem their new key.
SITE_URL=https://champ-site-psi.vercel.app

# Persistent files: ticket categories, ticket panels and what the bot learned (rules, lessons,
# ticket actions) plus the /ai-stop switch live in DATA_DIR. On Railway mount a volume at /data
# and set DATA_DIR=/data; otherwise these settings reset on every deploy.
DATA_DIR=

# AI support + trusted operator actions (OpenAI-compatible endpoint, Groq by default)
AI_API_KEY=your-groq-or-gemini-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_SITE_URLS=https://your-live-site.example
AI_HIDDEN_HOSTS=champclient.com
# Account usernames (not display names) that may make the bot perform real actions, and may
# teach it in the training channel. /ai-stop takes those actions away, /ai-start gives them back.
# Defaults to sora_developing,silvan. Add exact IDs for extra safety.
AI_TRUSTED_USERS=sora_developing,silvan
AI_TRUSTED_USER_IDS=
AI_MAX_CALLS_PER_MINUTE=20
AI_KNOWLEDGE_DIR=

# Shared support engine on the website (empty disables it)
SUPPORT_API_URL=https://champ-site-psi.vercel.app
