# Discord (Developer Portal -> Bot -> Token + General Information -> Application ID)
DISCORD_TOKEN=jouw-bot-token-hier
CLIENT_ID=jouw-applicatie-client-id
GUILD_ID=jouw-server-id

# Supabase (optioneel maar aanbevolen: tickets, beoordelingen en transcripts
# worden dan in de database bewaard i.p.v. lokale JSON-bestanden).
# Zonder deze twee regels valt de bot automatisch terug op data/tickets.json.
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_SERVICE_KEY=jouw-service-role-key-hier
